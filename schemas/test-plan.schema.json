{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Selenium Autopilot Test Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "summary", "scenarios", "ambiguities", "risks"],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "priority",
          "category",
          "preconditions",
          "steps",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "enum": ["critical", "high", "medium", "low"]
          },
          "category": {
            "enum": ["positive", "negative", "boundary", "authorization"]
          },
          "preconditions": {
            "$ref": "#/$defs/stringList"
          },
          "steps": {
            "$ref": "#/$defs/nonEmptyStringList"
          },
          "expected": {
            "$ref": "#/$defs/nonEmptyStringList"
          }
        }
      }
    },
    "ambiguities": {
      "$ref": "#/$defs/stringList"
    },
    "risks": {
      "$ref": "#/$defs/stringList"
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "nonEmptyStringList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
