{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Selenium Autopilot Healing Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "category",
    "summary",
    "target_file",
    "old_locator",
    "new_locator",
    "strategy",
    "rationale",
    "confidence",
    "risks",
    "evidence",
    "locator_match_count",
    "uniqueness",
    "proposed_diff",
    "human_review_required",
    "applied",
    "validation"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "category": {
      "enum": [
        "locator_drift",
        "synchronization",
        "application_defect",
        "invalid_test_data",
        "environment",
        "unknown"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "target_file": {
      "type": "string",
      "minLength": 1
    },
    "old_locator": {
      "type": "string",
      "minLength": 1
    },
    "new_locator": {
      "type": "string",
      "minLength": 1
    },
    "strategy": {
      "enum": ["css", "xpath", "id", "name"]
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "risks": {
      "$ref": "#/$defs/stringList"
    },
    "evidence": {
      "$ref": "#/$defs/stringList"
    },
    "locator_match_count": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "uniqueness": {
      "enum": ["unique", "not_unique", "not_checked"]
    },
    "proposed_diff": {
      "type": "string"
    },
    "human_review_required": {
      "const": true
    },
    "applied": {
      "const": false
    },
    "validation": {
      "const": "not_run"
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
