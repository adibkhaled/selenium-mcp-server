{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Selenium Autopilot Test Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "summary", "failures"],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "source": {
      "enum": ["junit", "unavailable"]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "passed", "failed", "errors", "skipped", "duration_seconds"],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "duration_seconds": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["nodeid", "outcome", "message"],
        "properties": {
          "nodeid": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "enum": ["failed", "error"]
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
