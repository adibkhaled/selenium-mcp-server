{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Selenium Autopilot Failure Analysis",
  "type": "object",
  "additionalProperties": false,
  "required": ["category", "confidence", "summary", "evidence", "next_steps"],
  "properties": {
    "category": {
      "enum": [
        "locator_drift",
        "synchronization",
        "application_defect",
        "invalid_test_data",
        "environment",
        "unknown"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "$ref": "#/$defs/stringList"
    },
    "next_steps": {
      "$ref": "#/$defs/stringList"
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
